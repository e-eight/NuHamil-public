#!/bin/bash
#SBATCH --job-name=nh-bench
#SBATCH --account=soham-ic
#SBATCH --partition=IllinoisComputes
#SBATCH --nodes=1
#SBATCH --ntasks=16
#SBATCH --cpus-per-task=1
#SBATCH --mem=128G
#SBATCH --time=04:00:00
#SBATCH --output=/scratch/soham/NuHamil-faster/runs/slurm-%j.out
#SBATCH --error=/scratch/soham/NuHamil-faster/runs/slurm-%j.err
# ---------------------------------------------------------------------------
# Run ONE NuHamil benchmark case.  Never run this on a login node.
#
#   sbatch bench/run_case.sbatch <case-id>
#
# Generate the input first (login-node safe):
#   python3 bench/gen_cases.py --cases <case-id>
#
# Override resources at SUBMIT time -- do not edit this file:
#   sbatch --partition=scavenger --requeue -n 32 -c 1 --mem=256G --time=12:00:00 \
#          bench/run_case.sbatch 3bme_e3max8
#
# Env knobs (export before sbatch, or use --export=ALL,KEY=VAL):
#   NUHAMIL_TAG=<tag>      build under $SCRATCH_ROOT/build/<tag>   (default: base)
#   NUHAMIL_BIN=<path>     explicit executable, overrides NUHAMIL_TAG
#   OMP_NUM_THREADS=N      OpenMP threads (default: $SLURM_CPUS_PER_TASK)
#   NUHAMIL_PROF_DUMP=0/1  per-rank per-category profiler dump (default: 1)
#   NH_SCRATCH_ROOT=<dir>  scratch root (default: /scratch/soham/NuHamil-faster)
#   NUHAMIL_RUNDIR=<dir>   override the run directory (default: $SCRATCH_ROOT/runs/<case-id>)
#                          Required when several configurations of the SAME case run
#                          concurrently: each run starts cold by deleting cfp/, ops/
#                          and *.gz, so two jobs sharing a directory would destroy
#                          each other's work in progress.
#
# Writes only under $SCRATCH_ROOT/runs/<case-id>/ ; nothing to $HOME.
# Per-run metadata goes to run-<jobid>.env, consumed by bench/collect.py.
# ---------------------------------------------------------------------------
set -euo pipefail

CASE="${1:?usage: run_case.sbatch <case-id>   (see bench/gen_cases.py --list)}"

SCRATCH_ROOT="${NH_SCRATCH_ROOT:-/scratch/soham/NuHamil-faster}"
REPO="${NH_REPO:-/u/soham/NuHamil-faster/upstream}"

# Refuse a partition that is not on the allow-list.  Defence in depth: the real
# guard is bench/submit.sh, which catches -p before sbatch is called.
# shellcheck source=partitions.sh
. "$REPO/bench/partitions.sh"
if ! nh_check_partition "${SLURM_JOB_PARTITION:-}"; then
    echo "ERROR: aborting before doing any work." >&2
    exit 2
fi

# Same for the account, and for the same reason: Slurm will charge whichever
# account it is given, but only soham-ic is this project's to spend.  Refusing
# here means a disallowed account cannot burn cluster time even if the job was
# queued by bypassing submit.sh.
if ! nh_check_account "${SLURM_JOB_ACCOUNT:-}"; then
    echo "ERROR: aborting before doing any work." >&2
    exit 2
fi

RUNDIR="${NUHAMIL_RUNDIR:-$SCRATCH_ROOT/runs/$CASE}"
TAG="${NUHAMIL_TAG:-base}"
NTASKS="${SLURM_NTASKS:-1}"
NCPU="${SLURM_CPUS_PER_TASK:-1}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-$NCPU}"
export NUHAMIL_PROF_DUMP="${NUHAMIL_PROF_DUMP:-1}"

# --- toolchain -------------------------------------------------------------
if ! command -v module >/dev/null 2>&1; then
    # shellcheck disable=SC1091
    source /etc/profile.d/lmod.sh 2>/dev/null || source /usr/share/lmod/lmod/init/bash
fi
module load gcc/13.3.0
module load gsl/2.8
if [ "$NTASKS" -gt 1 ]; then
    module load openmpi/5.0.1-gcc-13.3.0
    # The first IB device on ICC nodes was observed down; the UCX path then
    # fails to initialise.  OB1 over shared memory + TCP is the known-good
    # configuration.  Revisit on GPU nodes in Phase 4.
    export OMPI_MCA_pml=ob1
    export OMPI_MCA_btl=self,sm,tcp
fi

# --- checks ----------------------------------------------------------------
cd "$RUNDIR" 2>/dev/null || {
    echo "ERROR: run dir does not exist: $RUNDIR" >&2
    echo "       run: python3 $REPO/bench/gen_cases.py --cases $CASE" >&2
    exit 2
}
INPUT="$(ls Input_*.dat 2>/dev/null | head -n1 || true)"
if [ -z "$INPUT" ]; then
    echo "ERROR: no Input_*.dat in $RUNDIR" >&2
    echo "       run: python3 $REPO/bench/gen_cases.py --cases $CASE" >&2
    exit 2
fi

# A missing manifest.json used to kill the job here: `sed file` exits 2, pipefail
# propagates it, set -e aborts -- with NO diagnostic at all, because every echo in
# this script comes later.  Warn instead, so the failure is legible.
if [ ! -f manifest.json ]; then
    echo "WARNING: no manifest.json in $RUNDIR; kind unknown (MPI support cannot be" >&2
    echo "         checked, and the recorded metadata will be incomplete)." >&2
fi
KIND="$(sed -n 's/.*"kind": *"\([A-Za-z0-9]*\)".*/\1/p' manifest.json 2>/dev/null | head -n1 || true)"
if [ "$NTASKS" -gt 1 ] && [ "$KIND" != "namelist3" ]; then
    echo "WARNING: kind=$KIND has no MPI support (only 3N lab-frame does); NuHamil will stop." >&2
fi

# --- locate executable -----------------------------------------------------
if [ -n "${NUHAMIL_BIN:-}" ]; then
    BIN="$NUHAMIL_BIN"
elif [ "$NTASKS" -gt 1 ]; then
    BIN="$SCRATCH_ROOT/build/$TAG/NuHamil_mpi.exe"
else
    BIN="$SCRATCH_ROOT/build/$TAG/NuHamil_serial.exe"
fi
if [ ! -x "$BIN" ]; then
    echo "ERROR: executable not found or not executable: $BIN" >&2
    echo "       build it on a compute node, or set NUHAMIL_BIN=<path>" >&2
    exit 2
fi

STAMP="$(date +%Y%m%dT%H%M%S)"
LOG="log.${CASE}.rank${NTASKS}.omp${OMP_NUM_THREADS}.${STAMP}.txt"
ENVF="run-${SLURM_JOB_ID:-local}.env"

# --- cold-start guarantee --------------------------------------------------
# NuHamil caches intermediates in the run directory (cfp/ = Jacobi space,
# ops/ = operators, NNint_*.gz = relative NN interaction) and skips them on a
# re-run.  A warm run therefore measures cache reads rather than compute and is
# NOT comparable with a cold one -- the deuteron returns a different printed
# quantity purely because the cache hit changes the code path.  Benchmark runs
# start clean by default; set NUHAMIL_CLEAN=0 to keep the cache (e.g. to resume
# a pre-empted job under scavenger --requeue).
COLD=0
if [ "${NUHAMIL_CLEAN:-1}" = "1" ]; then
    rm -rf cfp ops ./*.me2j.gz ./*.me3j.gz ./*.gz
    COLD=1
fi

echo "=== case=${CASE} kind=${KIND} job=${SLURM_JOB_ID:-?} node=${SLURM_NODELIST:-?}"
echo "=== ranks=${NTASKS} cpus/rank=${NCPU} OMP=${OMP_NUM_THREADS} part=${SLURM_JOB_PARTITION:-?}"
echo "=== bin=${BIN}"
echo "=== input=${INPUT}  log=${LOG}  cold=${COLD}"
echo "=== restart=${SLURM_RESTART_COUNT:-0}  start=$(date -Is)"

START_EPOCH=$(date +%s)

set +e
if [ "$NTASKS" -gt 1 ]; then
    srun --mpi=pmix -n "$NTASKS" "$BIN" "$INPUT" > "$LOG" 2>&1
    RC=$?
else
    # per-process resource usage is only meaningful for the single-rank run
    /usr/bin/time -v "$BIN" "$INPUT" > "$LOG" 2>&1
    RC=$?
fi
set -e

END_EPOCH=$(date +%s)
WALL=$((END_EPOCH - START_EPOCH))

{
    echo "case=$CASE"
    echo "kind=${KIND:-unknown}"
    echo "jobid=${SLURM_JOB_ID:-local}"
    echo "jobname=${SLURM_JOB_NAME:-?}"
    echo "partition=${SLURM_JOB_PARTITION:-?}"
    echo "nodelist=${SLURM_NODELIST:-?}"
    echo "ntasks=$NTASKS"
    echo "cpus_per_task=$NCPU"
    echo "omp_num_threads=$OMP_NUM_THREADS"
    echo "total_threads=$((NTASKS * OMP_NUM_THREADS))"
    echo "binary=$BIN"
    echo "tag=$TAG"
    echo "input=$INPUT"
    echo "log=$LOG"
    echo "scratch_root=$SCRATCH_ROOT"
    echo "cold=$COLD"
    echo "wall_s=$WALL"
    echo "exit_code=$RC"
    echo "restart_count=${SLURM_RESTART_COUNT:-0}"
    echo "prof_dump=$NUHAMIL_PROF_DUMP"
    echo "start=$(date -Is -d @"$START_EPOCH")"
    echo "end=$(date -Is -d @"$END_EPOCH")"
} > "$ENVF"

echo "=== exit=${RC} wall=${WALL}s  wrote ${ENVF}"
echo "--- profiler lines ---"
grep -c '^#PROF_RANK' "$LOG" 2>/dev/null | sed 's/^/#PROF_RANK lines: /' || true
grep '^#PROF_RANK' "$LOG" 2>/dev/null | head -n 3 || true
echo "--- tail ---"
tail -n 15 "$LOG" || true
echo "=== finished $(date -Is)"
exit $RC
